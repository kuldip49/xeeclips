NODE_ENV=development

FRONTEND_PORT=3000
BACKEND_PORT=4000
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_MS=1800000
ENABLE_VISUAL_ANALYSIS=false
VISUAL_INTELLIGENCE_ENABLED=true
YOLO_MODEL=yolo26n.pt
VISUAL_ANALYSIS_PROFILE=BALANCED
VISUAL_SAMPLE_INTERVAL_SEC=2.75
VISUAL_MAX_FRAMES=2400
VISUAL_EXPENSIVE_MAX_FRAMES=600
VISUAL_ANALYSIS_BUDGET_SEC=0
VISUAL_YOLO_CONFIDENCE=0.35
VISUAL_YOLO_IMGSZ=416
VISUAL_YOLO_BATCH_SIZE=16
VISUAL_YOLO_CLASSES=person,car,bicycle,motorcycle,bus,truck,cat,dog,cell phone,laptop,tv,book,sports ball,skateboard,surfboard
VISUAL_OCR_ENABLED=true
VISUAL_OCR_MAX_FRAMES=120
VISUAL_OCR_RATIO=0.15
VISUAL_FACE_ENABLED=true
VISUAL_FACE_LANDMARKS_ENABLED=true
VISUAL_FACE_LANDMARKER_MAX_FRAMES=40
VISUAL_SCENE_ENABLED=true
VISUAL_CACHE_ENABLED=true
VISUAL_CACHE_DIR=/models/visual/cache
FORCE_REPROCESS=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_STYLE=responses
LLM_TIMEOUT_MS=90000
LLM_SAFE_INPUT_CHARS=60000
LLM_MAX_RETRIES=0
LLM_RETRY_BASE_DELAY_MS=1000
LLM_RETRY_MAX_DELAY_MS=5000
LLM_RETRY_JITTER_MS=750
CLIP_JUDGE_PROVIDER=openai
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MULTIMODAL_PROVIDER=nvidia
NVIDIA_MULTIMODAL_MODEL=
NVIDIA_REASONING_PROVIDER=nvidia
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_TIMEOUT_MS=90000
NVIDIA_CONCURRENCY=2
NVIDIA_SUPER_CONCURRENCY=2
NVIDIA_OMNI_CONCURRENCY=1
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_CREATIVE_PROVIDER=google
GOOGLE_CREATIVE_MODEL=
GOOGLE_TIMEOUT_MS=90000
GOOGLE_CONCURRENCY=1
GOOGLE_MULTIMODAL_FAILOVER_ENABLED=true
NVIDIA_OMNI_TEXT_FAILOVER_ENABLED=false
# ONLINE uses the paid OpenAI Luna connector only. Other adapters remain available
# in the codebase but are disabled from the active ONLINE pool.
ONLINE_PROVIDER_ORDER=openai
GOOGLE_ENABLED=false
NVIDIA_ENABLED=false
OPENAI_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CONCURRENCY=2
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_CONCURRENCY=2
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CONCURRENCY=2
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CONCURRENCY=2
# Any role may override global order/model, for example:
# LLM_CREATIVE_GENERATION_PROVIDERS=anthropic,google,openai,nvidia
# GOOGLE_CREATIVE_GENERATION_MODEL=gemini-model-id
# OPENAI_CRITIC_MODEL=openai-model-id
LLM_QUOTA_COOLDOWN_MS=3600000
LOCAL_WHOLE_VIDEO_INPUT_CHARS=12000
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_WINDOW_MS=60000
LLM_CIRCUIT_COOLDOWN_MS=45000
LLM_JOB_MAX_CALLS=60
LLM_JOB_MAX_CRITIC_CALLS=4
LLM_JOB_MAX_REPAIR_CALLS=4
LLM_JOB_MAX_RETRY_CALLS=12
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=90000
# AI editor / creative-brief reading. Unset = ONLINE (OpenAI when a key is configured,
# otherwise honest NOT_CONFIGURED + deterministic rules). FALLBACK_ONLY forces rules-only.
# EDIT_MODE_CHAT_AI_MODE=ONLINE
# Compact creative packages use one candidate per request.
CLIP_JUDGE_CONCURRENCY=1
CLIP_UNDERSTANDING_BATCH_SIZE=2
CLIP_UNDERSTANDING_CONCURRENCY=1
CLIP_CRITIC_CONCURRENCY=1
LLM_MULTIMODAL_UNDERSTANDING_TIMEOUT_MS=18000
LLM_WHOLE_VIDEO_UNDERSTANDING_TIMEOUT_MS=18000
LLM_CLIP_UNDERSTANDING_TIMEOUT_MS=18000
LLM_CREATIVE_GENERATION_TIMEOUT_MS=20000
LLM_CRITIC_TIMEOUT_MS=12000
LLM_COMPONENT_REPAIR_TIMEOUT_MS=15000
# ONLINE role-specific provider overrides are ignored; every ONLINE role uses OpenAI Luna.
CLIP_MIN_STRONG_SCORE=60

DATABASE_URL=
POSTGRES_DB=ai_content_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

REDIS_URL=redis://redis:6379
VIDEO_WORKER_CONCURRENCY=1
# Clip rendering queue: parallel renders, and the grace window before an orphaned
# QUEUED/RENDERING request (no live queue job) is marked retryable FAILED.
CLIP_RENDER_CONCURRENCY=1
CLIP_RENDER_STALE_MS=120000
# Frontend: show pipeline internals (stages, chunks, understanding) in the project workspace.
SHOW_DEVELOPER_DIAGNOSTICS=false

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=ai-content-platform

WHISPER_MODEL=base
WHISPER_MODEL_PATH=/models/whisper-base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD_MIN_SILENCE_MS=500
WHISPER_DIARIZATION_ENABLED=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

NEXT_PUBLIC_API_URL=http://localhost:4000
SERVER_API_URL=http://backend:4000
# Comma-separated exact browser origins; production: https://xeeclip.me,http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
# Bounded per-role attempts (including the initial request), independent of fixed timeouts.
# Normal roles allow at most two attempts; critic and component repair default to one.
LLM_MULTIMODAL_UNDERSTANDING_TIMEOUT_MS=25000
LLM_MULTIMODAL_UNDERSTANDING_MAX_ATTEMPTS=2
LLM_WHOLE_VIDEO_UNDERSTANDING_TIMEOUT_MS=35000
LLM_WHOLE_VIDEO_UNDERSTANDING_MAX_ATTEMPTS=2
LLM_CLIP_UNDERSTANDING_TIMEOUT_MS=25000
LLM_CLIP_UNDERSTANDING_MAX_ATTEMPTS=2
LLM_CREATIVE_GENERATION_TIMEOUT_MS=25000
LLM_CREATIVE_GENERATION_MAX_ATTEMPTS=2
LLM_CRITIC_TIMEOUT_MS=20000
LLM_CRITIC_MAX_ATTEMPTS=2
LLM_COMPONENT_REPAIR_TIMEOUT_MS=15000
LLM_COMPONENT_REPAIR_MAX_ATTEMPTS=2
CLIP_CRITIC_CONCURRENCY=3

# EDITED_CLIPS editing quality
EDIT_DENSE_ANALYSIS_ENABLED=true
EDIT_ANALYSIS_FPS=4
# Background music for AI_EDITED clips. Off: the current editorial standard is
# dialogue only, so no bed is mixed and the music QA checks report N/A. Set both
# to true to restore beds - the library and mixing architecture is unchanged.
EDIT_MUSIC_ENABLED=false
EDIT_MUSIC_REQUIRED=false
# Curated music library. Drop your own licensed / royalty-free / owned tracks into
# the mood folders under apps/backend/assets/music and run `npm run music:scan`
# in apps/backend. See apps/backend/assets/music/README.md.
EDIT_MUSIC_DIR=
# Local auditioning only: lets tracks without an approved license be used.
EDIT_MUSIC_ALLOW_UNLICENSED=false
# Sound design for camera-motion events. Drop short effects into the category
# folders under apps/backend/assets/sfx - no manifest or scan step needed.
# See apps/backend/assets/sfx/README.md.
# Motion sound design. Off for the same reason as music: dialogue/source audio only.
EDIT_SFX_ENABLED=false
EDIT_SFX_DIR=
# The in-graph generated effects used when a category has no local asset.
# Set false to ship only effects you provided yourself.
EDIT_SFX_ALLOW_GENERATED=true
# Bounded AI Edited throughput. Values are clamped to 1..4.
AI_EDITED_RENDER_CONCURRENCY=2
# Optional per-render override. When empty, CPU threads are divided across the
# configured render concurrency with a conservative cap.
FFMPEG_THREADS_PER_RENDER=
# Hard ceiling for expensive full-video attempts (legacy alias remains supported).
MAX_FULL_VIDEO_RENDER_ATTEMPTS=2
EDIT_MAX_RENDER_ATTEMPTS=2

# Optional YouTube source acquisition. Supply an approved yt-dlp executable in the
# backend runtime. Without it URL imports fail explicitly and file uploads remain available.
# Enable only when this deployment has the necessary YouTube authorization.
YOUTUBE_IMPORT_APPROVED=false
# Public Instagram/X retrieval only, with per-video rights confirmation. No cookies or login.
QUICK_REFRAME_SOCIAL_IMPORT_APPROVED=false
YOUTUBE_IMPORT_BINARY=yt-dlp
# Import limits (seconds unless noted). Older names MAX_IMPORT_DURATION_SECONDS,
# MAX_IMPORT_FILE_BYTES and IMPORT_TIMEOUT_MS are still read as fallbacks.
# CONNECT_TIMEOUT: per network operation. TOTAL_TIMEOUT: the whole import (metadata, every
# attempt and normalization) - sized for 2-hour sources. STALL_TIMEOUT: a download with no
# progress for this long is retried as a network failure. MAX_DURATION is capped at the
# platform's 2-hour source limit; nothing is ever truncated - longer videos are refused.
YOUTUBE_IMPORT_CONNECT_TIMEOUT=30
YOUTUBE_IMPORT_TOTAL_TIMEOUT=10800
YOUTUBE_IMPORT_STALL_TIMEOUT=300
YOUTUBE_IMPORT_MAX_DURATION=7200
YOUTUBE_IMPORT_MAX_BYTES=4294967296
# Attempts per step for transient failures only (network/5xx/429), with exponential backoff.
YOUTUBE_IMPORT_MAX_ATTEMPTS=3
# Imports processed side by side (one long import never blocks another link).
YOUTUBE_IMPORT_CONCURRENCY=2
