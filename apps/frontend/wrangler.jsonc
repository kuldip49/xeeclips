{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xeeclips-frontend",
  // The site is a static export (`npm run build:cloudflare` -> out/). Files are served directly
  // from the asset store; the router only runs for the per-id paths (see cloudflare/router.mjs).
  "main": "cloudflare/router.mjs",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "xeeclip.me", "custom_domain": true }
  ],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    // Campaign navigations use the asset SPA fallback. Legacy editor/project paths still use
    // their existing static-shell router. Clippers does not need that runtime.
    "run_worker_first": ["/edit-mode/*", "/projects/*"]
  },
  "observability": {
    "enabled": true
  }
}
