{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xeeclips-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "xeeclip.me", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "xeeclips-frontend"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://api.xeeclip.me",
    "SERVER_API_URL": "https://api.xeeclip.me"
  },
  "observability": {
    "enabled": true
  }
}
