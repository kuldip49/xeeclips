# Curated music: the folder layout and README are tracked, the audio you drop in
# (and the manifest scanned from it) is yours and stays local.
apps/backend/assets/music/**/*.mp3
apps/backend/assets/music/**/*.m4a
apps/backend/assets/music/**/*.wav
apps/backend/assets/music/**/*.aac
apps/backend/assets/music/**/*.ogg
apps/backend/assets/music/**/*.flac
apps/backend/assets/music/curated.json
# Generated beds (scripts/generate-music-library.cjs), rebuilt on every image build
apps/backend/assets/music-generated/

# Local sound-design assets: the folder layout and README are tracked, the audio
# you drop in (and the sfx.json that refines it) is yours and stays local.
apps/backend/assets/sfx/**/*.wav
apps/backend/assets/sfx/**/*.mp3
apps/backend/assets/sfx/**/*.m4a
apps/backend/assets/sfx/**/*.ogg
apps/backend/assets/sfx/**/*.flac
apps/backend/assets/sfx/sfx.json

